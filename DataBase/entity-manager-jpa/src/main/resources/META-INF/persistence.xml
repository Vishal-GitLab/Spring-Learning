<?xml version="1.0" encoding="UTF-8"?>
<!-- iske jariye ak configuration define kar rhe hai JPA ke through-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

<!--    ise ham java code me use karenge -->
    <persistence-unit name="myJpaUnit">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>UserClassHibernate</class>
        <properties>
<!--            ye sari properties database related aur data connection base hai -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/demo_db"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="Root@12345"/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
<!--            agar hame property dekhna hai to ise  unable rkhna padega -->
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>